# mount point	fstype	device											device2				flags

# Dynamic/Logical partitions (in super)
/system		ext4	system											flags=display="System";logical;slotselect;flashimg=1
/system_ext	ext4	system_ext										flags=display="System_ext";logical;slotselect
/vendor		ext4	vendor											flags=display="Vendor";logical;slotselect;flashimg=1
/product	ext4	product											flags=display="Product";logical;slotselect;flashimg=1
/odm		ext4	odm												flags=display="ODM";logical;slotselect;flashimg=1

# Boot partitions
/boot		emmc	/dev/block/bootdevice/by-name/boot				flags=slotselect;flashimg=1
/init_boot	emmc	/dev/block/bootdevice/by-name/init_boot			flags=slotselect;display="Init Boot";flashimg=1
/vendor_boot	emmc	/dev/block/bootdevice/by-name/vendor_boot		flags=slotselect;display="Vendor Boot";flashimg=1
/recovery	emmc	/dev/block/bootdevice/by-name/recovery			flags=slotselect;display="Recovery";flashimg=1

# AVB partitions
/vbmeta		emmc	/dev/block/bootdevice/by-name/vbmeta			flags=slotselect;display="VBMeta";flashimg=1
/vbmeta_system	emmc	/dev/block/bootdevice/by-name/vbmeta_system		flags=slotselect;display="VBMeta System";flashimg=1
/vbmeta_vendor	emmc	/dev/block/bootdevice/by-name/vbmeta_vendor		flags=slotselect;display="VBMeta Vendor";flashimg=1

# DTBO
/dtbo		emmc	/dev/block/bootdevice/by-name/dtbo				flags=slotselect;display="DTBO";flashimg=1

# Userdata
/data		f2fs	/dev/block/bootdevice/by-name/userdata			flags=display="Data";storage;wipeingui;cryptofooter
/metadata	f2fs	/dev/block/bootdevice/by-name/metadata			flags=display="Metadata"

# Modem/Firmware
/modem		emmc	/dev/block/bootdevice/by-name/modem				flags=slotselect;display="Modem";flashimg=1
/dsp		emmc	/dev/block/bootdevice/by-name/dsp				flags=slotselect;display="DSP";flashimg=1
/bluetooth	emmc	/dev/block/bootdevice/by-name/bluetooth			flags=slotselect;display="Bluetooth";flashimg=1

# EFS partitions
/efs1		emmc	/dev/block/bootdevice/by-name/modemst1			flags=backup=1;display="EFS1"
/efs2		emmc	/dev/block/bootdevice/by-name/modemst2			flags=backup=1;display="EFS2"
/efsc		emmc	/dev/block/bootdevice/by-name/fsc				flags=backup=1;display="FSC"
/efsg		emmc	/dev/block/bootdevice/by-name/fsg				flags=backup=1;display="FSG"

# Persist
/persist	ext4	/dev/block/bootdevice/by-name/persist			flags=display="Persist";fsflags=ro

# Oplus specific
/oplusreserve	emmc	/dev/block/bootdevice/by-name/oplusreserve1	flags=display="Oplus Reserve";backup=1

# Removable storage
/external_sd	vfat	/dev/block/mmcblk1p1	/dev/block/mmcblk1	flags=display="MicroSD";storage;wipeingui;removable
/usbstorage	auto	/dev/block/sdg1		/dev/block/sdg		flags=fsflags=utf8;display="USB Storage";storage;wipeingui;removable
